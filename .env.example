# LEANWARES web — environment variables (docs/DEPLOYMENT_MODES.md).
# Copy to .env.local for local overrides. Never commit real secrets. No analytics or
# tracking variables exist yet (none approved).

# development | staging | production
# Unset: `next dev` → development; any production build → staging (safe default).
LW_SITE_MODE=development

# Absolute origin without a trailing slash. Required for staging and production
# (canonical URLs, sitemap.xml, Open Graph URLs).
LW_SITE_URL=

# Staging only: "1" allows copy marked reviewStatus "draft" (needed until LEANWARES approves
# the drafts listed in docs/LAUNCH_READINESS.md). Ignored in production.
LW_ALLOW_DRAFT=

# Production only, after explicit approval: "1" enables indexing (robots.txt, meta robots,
# X-Robots-Tag). Ignored in development and staging, which are always noindex.
LW_ALLOW_INDEXING=

# "1": /foundation/* internal fixture previews in a non-production-mode build.
LW_INTERNAL_PREVIEW=

# "1": internal review build may use the text logo fallback. Never lifts the production gate.
LW_ALLOW_LOGO_FALLBACK=

# Future form backend: same-origin path of an approved first-party endpoint (e.g. /api/…).
# Absolute / third-party URLs are ignored by design. Unset → forms never report success.
LW_CONTACT_FORM_ENDPOINT=
LW_DOWNLOAD_FORM_ENDPOINT=

# Analytics: intentionally absent. To be added only after tools and consent are approved.
